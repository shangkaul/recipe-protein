{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PantryRefinement",
  "type": "object",
  "additionalProperties": false,
  "required": ["terms", "ignored_terms"],
  "properties": {
    "terms": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["raw_term", "canonical_id", "role", "confidence"],
        "properties": {
          "raw_term": { "type": "string" },
          "canonical_id": { "type": "string" },
          "role": { "enum": ["core", "basic"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "ignored_terms": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["raw_term", "reason"],
        "properties": {
          "raw_term": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
